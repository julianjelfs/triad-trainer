#!/usr/bin/env bash
# Control Triad Trainer, which runs on the Pi. Everything here drives that machine over
# SSH; nothing in this repo runs the app on the laptop any more.
set -euo pipefail

PI="${TRIADS_PI_HOST:-julian_jelfs@pi.local}"
REMOTE="triad-trainer"
HOUSE_URL="https://triads.julianjelfs.co.uk"
# Reachable from outside the house, and from inside it when DNS is being difficult.
TAILNET_URL="https://pi.tail50bfbf.ts.net:8443"
ROOT="$(cd "$(dirname "$(readlink "${BASH_SOURCE[0]}" || echo "${BASH_SOURCE[0]}")")/.." && pwd)"

on_pi() { ssh -o BatchMode=yes -o ConnectTimeout=10 "$PI" "$@"; }

url() {
	if [ -n "$(dig +short A triads.julianjelfs.co.uk 2>/dev/null)" ]; then
		echo "$HOUSE_URL"
	else
		echo "$TAILNET_URL"
	fi
}

case "${1:-open}" in
	open) open "$(url)" ;;
	url) url ;;
	ssh) exec ssh "$PI" ;;

	status)
		on_pi '
			printf "app       : %s\n" "$(systemctl is-active triads)"
			printf "caddy     : %s\n" "$(systemctl is-active caddy)"
			if curl -sf -m 3 http://127.0.0.1:8000/api/health >/dev/null; then
				printf "api       : responding on 127.0.0.1:8000\n"
			else
				printf "api       : NOT responding\n"
			fi
			printf "backups   : %s, newest %s\n" "$(ls -1 ~/triads-backups/triads-*.db 2>/dev/null | wc -l | tr -d " ")" "$(ls -1t ~/triads-backups/triads-*.db 2>/dev/null | head -1 | xargs -r basename)"
			printf "next backup: %s\n" "$(systemctl list-timers triads-backup --no-pager 2>/dev/null | awk "NR==2 {print \$1, \$2, \$3}")"
			printf "cpu temp  : %.1fC\n" "$(awk "{print \$1/1000}" /sys/class/thermal/thermal_zone0/temp)"
			printf "uptime    : %s\n" "$(uptime -p)"
		'
		echo "url       : $(url)"
		;;

	logs)   on_pi "sudo journalctl -u triads -n ${2:-40} -f" ;;

	start)   on_pi "sudo systemctl start triads"; echo "started" ;;
	stop)    on_pi "sudo systemctl stop triads"; echo "stopped" ;;
	restart) on_pi "sudo systemctl restart triads"; echo "restarted" ;;

	rebuild)
		# The Pi never builds the frontend: Vite stays on the laptop.
		if [ -n "$(git -C "$ROOT" status --porcelain)" ]; then
			echo "warning: uncommitted changes here; the Pi pulls from GitHub and will not see them" >&2
		fi
		echo "==> pulling code on the Pi"
		on_pi "cd $REMOTE && git pull -q && git log --oneline -1"
		echo "==> syncing backend dependencies"
		on_pi "cd $REMOTE/backend && ~/.local/bin/uv sync -q && echo ok"
		echo "==> building the frontend here"
		(cd "$ROOT/frontend" && npm install --silent && npm run build >/dev/null)
		echo "==> copying the build across"
		rsync -az --delete -e "ssh -o BatchMode=yes" "$ROOT/frontend/dist/" "$PI:$REMOTE/frontend/dist/"
		echo "==> restarting"
		on_pi "sudo systemctl restart triads"
		for _ in $(seq 1 40); do
			on_pi "curl -sf -m 1 http://127.0.0.1:8000/api/health" >/dev/null 2>&1 && break
			sleep 0.5
		done
		on_pi "curl -sf -m 3 http://127.0.0.1:8000/api/health" >/dev/null \
			&& echo "done, service healthy. Reload the page." \
			|| { echo "service did not come back; try: triad-trainer logs"; exit 1; }
		;;

	backup)
		echo "==> taking a backup on the Pi"
		on_pi "sudo systemctl start triads-backup && sudo journalctl -u triads-backup -n 3 --no-pager | tail -2"
		echo "==> pulling it here"
		bash "$ROOT/deploy/pull-backups.sh"
		;;

	pull) bash "$ROOT/deploy/pull-backups.sh" ;;

	*)
		cat <<'USAGE'
triad-trainer: the guitar practice app, running on the Pi

  triad-trainer              open it in a browser
  triad-trainer status       app, Caddy, backups, temperature
  triad-trainer url          print the URL
  triad-trainer rebuild      after changing code: pull on the Pi, build the UI here, restart
  triad-trainer logs [n]     follow the app log
  triad-trainer backup       take a backup now and pull it to this laptop
  triad-trainer pull         pull existing backups to this laptop
  triad-trainer ssh          shell onto the Pi
  triad-trainer start|stop|restart
USAGE
		;;
esac
