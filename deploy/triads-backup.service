# One nightly backup run. Driven by triads-backup.timer.
[Unit]
Description=Back up the Triad Trainer database
Documentation=https://github.com/julianjelfs/triad-trainer

[Service]
Type=oneshot
User=julian_jelfs
ExecStart=/home/julian_jelfs/triad-trainer/deploy/backup.sh
StandardOutput=journal
StandardError=journal
